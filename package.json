{
  "name": "jpilot",
  "private": true,
  "version": "0.1.0",
  "description": "Jpilot — AI-assisted YouTube channel operating system",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "node apps/server/dist/index.js",
    "start:server": "node apps/server/dist/index.js",
    "start:web": "pnpm --filter @jpilot/web start",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @jpilot/server db:generate",
    "db:migrate": "pnpm --filter @jpilot/server db:migrate",
    "db:push": "pnpm --filter @jpilot/server db:push",
    "db:studio": "pnpm --filter @jpilot/server db:studio",
    "clean": "turbo clean && rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
